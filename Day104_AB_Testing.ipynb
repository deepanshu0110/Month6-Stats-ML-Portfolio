   "source": [
    "# ── Task B2: Power Analysis  ──────────────────────────────────────\n",
    "# Goal: Determine required sample size per group to achieve 80% power for both AOV and conversion tests\n",
    "# Method: TTestIndPower (continuous) + NormalIndPower (proportions)\n",
    "\n",
    "from statsmodels.stats.power import TTestIndPower, NormalIndPower\n",
    "from statsmodels.stats.proportion import proportion_effectsize\n",
    "\n",
    "# --- AOV test power analysis ---\n",
    "# Use Cohen's d from B1 (we recompute to be safe, or use the variable from earlier)\n",
    "# If you already have variable 'd' from B1, you can skip recomputation.\n",
    "# Otherwise, recompute from summary stats:\n",
    "aov_A = df[df['group'] == 'A']['aov']\n",
    "aov_B = df[df['group'] == 'B']['aov']\n",
    "mean_A, mean_B = aov_A.mean(), aov_B.mean()\n",
    "std_A, std_B = aov_A.std(ddof=1), aov_B.std(ddof=1)\n",
    "pooled_sd = np.sqrt((std_A**2 + std_B**2) / 2)\n",
    "d = (mean_B - mean_A) / pooled_sd\n",
    "\n",
    "power_cont = TTestIndPower()\n",
    "n_needed_aov = power_cont.solve_power(effect_size=d, alpha=0.05, power=0.80, alternative='two-sided')\n",
    "n_needed_aov = int(np.ceil(n_needed_aov))\n",
    "\n",
    "# --- Conversion test power analysis ---\n",
    "# Get conversion rates from summary table (or recompute)\n",
    "conv_A = df[df['group'] == 'A']['converted'].mean()   # 0.6333\n",
    "conv_B = df[df['group'] == 'B']['converted'].mean()   # 0.7267\n",
    "h = proportion_effectsize(conv_B, conv_A)             # Cohen's h\n",
    "\n",
    "power_prop = NormalIndPower()\n",
    "n_needed_conv = power_prop.solve_power(effect_size=h, alpha=0.05, power=0.80, alternative='two-sided')\n",
    "n_needed_conv = int(np.ceil(n_needed_conv))\n",
    "\n",
    "# --- Print results ---\n",
    "print(\"=== B2: Power Analysis ===\")\n",
    "print(f\"AOV test:        current n=150, needed={n_needed_aov} per group → {'Adequately powered' if n_needed_aov <= 150 else 'Underpowered'}\")\n",
    "print(f\"Conversion test: current n=150, needed={n_needed_conv} per group → {'Adequately powered' if n_needed_conv <= 150 else 'Underpowered'}\")\n",
    "\n",
    "# Plain English explanation (required by rubric)\n",
    "print(\"\\n'Underpowered' means the experiment didn't have enough users to reliably detect the conversion rate difference.\")\n",
