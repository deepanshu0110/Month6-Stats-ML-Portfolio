    "# ── Task B1: AOV — Two-Sample Welch's T-Test ────────────────────────────────\n",
    "# Goal: Determine if Express Checkout users spend significantly more per order\n",
    "# Method: Welch's t-test + Cohen's d effect size\n",
    "\n",
    "aov_A = df[df['group']=='A']['aov']\n",
