    "# ── Task A2: Conversion Rate — Two-Proportion Z-Test ───────────────────────\n",
    "# Goal: Determine if Express Checkout significantly improves conversion rate\n",
    "# Method: Manual z-stat formula + proportions_ztest verification\n",
    "\n",
    "# Step 1: Print H0 and H1\n",
    "# Step 2: Compute pooled p, SE, z-stat, p-value manually\n",
    "# Step 3: Verify with proportions_ztest\n",
    "# Step 4: Print result in required format\n",
    "\n",
    "n_A = n_B = 150\n",
    "conv_A = summary[summary['group']=='A']['conversions'].values[0]\n",
    "conv_B = summary[summary['group']=='B']['conversions'].values[0]\n",
    "p_A = conv_A / n_A\n",
    "p_B = conv_B / n_B\n",
    "\n",
    "# Manual calculation using p_B - p_A (positive difference)\n",
    "p_pool = (conv_A + conv_B) / (n_A + n_B)\n",
    "se = np.sqrt(p_pool * (1 - p_pool) * (1/n_A + 1/n_B))\n",
    "z_conv = (p_B - p_A) / se          # positive now\n",
    "p_conv = 2 * (1 - norm.cdf(z_conv))\n",
    "\n",
    "# statsmodels verification (order: [conv_B, conv_A] to get positive z)\n",
    "count_conv = [conv_B, conv_A]      # B first, then A\n",
    "nobs_conv = [n_B, n_A]\n",
    "z_verif, p_verif = proportions_ztest(count_conv, nobs_conv, alternative='two-sided')\n",
    "\n",
