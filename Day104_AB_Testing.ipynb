    "return_B = df[df['group']=='B']['returned'].sum()\n",
    "count_ret = [return_A, return_B]\n",
    "nobs_ret = [n, n]\n",
    "z_ret, p_ret = proportions_ztest(count_ret, nobs_ret, alternative='two-sided')\n",
    "\n",
    "bonferroni_alpha = 0.05 / 3\n",
    "\n",
    "print(\"=== Bonus: Return Rate Z-Test ===\")\n",
    "print(f\"Group A returns: {return_A}/{n} = {return_A/n:.4f}\")\n",
    "print(f\"Group B returns: {return_B}/{n} = {return_B/n:.4f}\")\n",
    "print(f\"z-stat = {z_ret:.4f}, p = {p_ret:.4f}\\n\")\n",
    "print(f\"Bonferroni corrected α = {bonferroni_alpha:.4f}\\n\")\n",
    "\n",
    "# Build table\n",
    "print(\"Test             | p-value | Bonferroni α | Significant?\")\n",
    "print(\"----------------------------------------------------------\")\n",
    "conv_sig = \"Yes\" if p_conv < bonferroni_alpha else \"No\"\n",
    "aov_sig  = \"Yes\" if p_aov < bonferroni_alpha else \"No\"\n",
